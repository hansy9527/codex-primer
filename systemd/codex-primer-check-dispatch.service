[Unit]
Description=Dispatch Codex Primer Check Slot

[Service]
Type=oneshot
ExecStart=/bin/bash -lc 'now=$$(TZ=Asia/Shanghai date +%%H:%%M); case "$$now" in 07:08) slot=07:00 ;; 12:13) slot=12:05 ;; 17:18) slot=17:10 ;; 22:23) slot=22:15 ;; *) echo "Unexpected check time: $$now" >&2; exit 2 ;; esac; systemctl start "codex-primer-check@$$slot.service"'
