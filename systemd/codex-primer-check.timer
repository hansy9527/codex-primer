[Unit]
Description=Codex Primer Result Check Schedule

[Timer]
OnCalendar=*-*-* 07:05:00 Asia/Shanghai
OnCalendar=*-*-* 12:10:00 Asia/Shanghai
OnCalendar=*-*-* 17:15:00 Asia/Shanghai
OnCalendar=*-*-* 22:20:00 Asia/Shanghai
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=codex-primer-check-dispatch.service

[Install]
WantedBy=timers.target
