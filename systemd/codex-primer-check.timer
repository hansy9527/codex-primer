[Unit]
Description=Codex Primer Result Check Schedule

[Timer]
OnCalendar=*-*-* 07:08:00 Asia/Shanghai
OnCalendar=*-*-* 12:13:00 Asia/Shanghai
OnCalendar=*-*-* 17:18:00 Asia/Shanghai
OnCalendar=*-*-* 22:23:00 Asia/Shanghai
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=codex-primer-check-dispatch.service

[Install]
WantedBy=timers.target
